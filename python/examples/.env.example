# Copy this file to `.env` (same folder) and fill in real values THERE.
#   cp .env.example .env      # then edit .env, NOT this file
# The examples auto-load `.env` — no `export` and no PyCharm config needed.
# `.env` is gitignored; do NOT put real secrets in this .env.example file.
# Real exported env vars still take precedence over values in `.env`.

# --- DNSE credentials (REST + WebSocket) ---
DNSE_API_KEY=your-api-key
DNSE_API_SECRET=your-api-secret
DNSE_ACCOUNT_NO=0001000115
DNSE_API_VERSION=2026-07-23
# DNSE_BASE_URL=https://openapi.dnse.com.vn
# DNSE_WS_URL=wss://ws-openapi.dnse.com.vn

# --- Auto-fetch OTP from email over IMAP ---
OTP_EMAIL_USER=you@gmail.com
OTP_EMAIL_PASSWORD=your-app-password
# OTP_IMAP_HOST=imap.gmail.com
# OTP_IMAP_PORT=993
# OTP_MAILBOX=INBOX
# OTP_FROM=dnse
# OTP_REGEX=(?<!\d)(\d{6})(?!\d)
# OTP_TIMEOUT=120
# OTP_POLL_INTERVAL=3
